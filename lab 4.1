using System;

class Program
{
    static void Main()
    {
        int[] values = { 6, 2, 5, 2, 1 };

        QuickSort(values, 0, values.Length);

        Console.WriteLine(string.Join(", ", values));
    }

    static void QuickSort(int[] values, int lo, int hi)
    {
        if (hi - lo <= 1)
            return;

        int p = Partition(values, lo, hi);

        QuickSort(values, lo, p);
        QuickSort(values, p + 1, hi);
    }

    static int Partition(int[] values, int lo, int hi)
    {
        int pivot = values[lo];
        int boundary = lo;

        for (int scan = lo + 1; scan < hi; scan++)
        {
            if (values[scan] < pivot)
            {
                boundary++;

                Swap(values, boundary, scan);
            }
        }

        Swap(values, lo, boundary);

        return boundary;
    }

    static void Swap(int[] values, int i, int j)
    {
        int temp = values[i];
        values[i] = values[j];
        values[j] = temp;
    }
}
